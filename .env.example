# Copie para .env (ou defina no sistema). Nunca versione o .env.

# Assistente com IA (opcional). Sem isso, o assistente funciona offline.
ANTHROPIC_API_KEY=
MEDREMIND_LLM_MODEL=claude-sonnet-5-5

# Token da API REST (opcional). Sem token, a API recusa todas as chamadas.
MEDREMIND_API_TOKEN=

# Pasta dos dados (padrão: ~/.medremind)
MEDREMIND_DATA_DIR=
