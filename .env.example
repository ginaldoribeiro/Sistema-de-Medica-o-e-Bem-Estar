# Copie para .env. Nunca versione o .env.

# ---------- Servidor (docker compose) ----------
JWT_SECRET=gere-com: python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=troque-esta-senha
CORS_ORIGINS=http://localhost:8550
# Push via Firebase Cloud Messaging (opcional)
FCM_SERVER_KEY=
# Assistente com IA no servidor e no app (opcional; sem isso funciona offline)
ANTHROPIC_API_KEY=
MEDREMIND_LLM_MODEL=claude-sonnet-5-5

# ---------- App ----------
# Endereço do servidor que o app usa ao entrar com conta
MEDREMIND_SERVER_URL=http://localhost:8000
# Pasta dos dados locais (padrão: ~/.medremind)
MEDREMIND_DATA_DIR=
